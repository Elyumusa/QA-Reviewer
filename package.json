{
  "name": "@levelbuild/cypress-quality-reviewer",
  "version": "0.1.4",
  "private": true,
  "description": "Standards-aware focused and multi-pass audit reviewer for Levelbuild WebApp Cypress tests",
  "type": "module",
  "files": [
    "dist/src",
    "README.md",
    "AUDIT_MODE_GUIDE.md",
    "PROVIDER_GUIDE.md",
    "REVIEWER_ARCHITECTURE_GUIDE.md",
    "standards"
  ],
  "bin": {
    "qa-review": "dist/src/cli.js"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean --silent && tsc -p tsconfig.json",
    "prepare": "npm run build --silent",
    "prepublishOnly": "npm test",
    "qa-review": "npm run build --silent && node dist/src/cli.js",
    "test": "npm run build --silent && node --test dist/test/**/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0"
  },
  "engines": {
    "node": ">=20"
  }
}
